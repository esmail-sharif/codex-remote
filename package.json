{
  "name": "codex-remote",
  "version": "0.3.0",
  "description": "Restricted Codex phone pairing for read-only Ridan Korea audit sessions.",
  "type": "module",
  "license": "MIT",
  "author": "Cheaux",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/esmail-sharif/codex-remote.git"
  },
  "homepage": "https://github.com/esmail-sharif/codex-remote/tree/ridankorea-audit-only",
  "bugs": {
    "url": "https://github.com/esmail-sharif/codex-remote/issues"
  },
  "keywords": [
    "android",
    "chatgpt",
    "codex",
    "codex-cli",
    "codex-plugin",
    "openai-codex",
    "linux",
    "mcp",
    "model-context-protocol",
    "qr-code",
    "phone-pairing",
    "remote-control",
    "terminal",
    "nodejs",
    "typescript",
    "developer-tools"
  ],
  "engines": {
    "node": ">=24"
  },
  "bin": {
    "codex-remote": "dist/cli.js"
  },
  "files": [
    "dist",
    "plugins",
    ".agents",
    "README.md",
    "LICENSE",
    "terminal-extension.json"
  ],
  "scripts": {
    "build": "node scripts/build.mjs",
    "check": "tsc --noEmit",
    "test": "npm run build && node --import tsx --test test/*.test.ts",
    "test:package": "npm run build && node scripts/check-package.mjs",
    "prepack": "npm run build",
    "package:directory": "python3 scripts/package-directory.py"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "1.32.1",
    "qrcode": "1.5.4",
    "ws": "8.22.0",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "@types/pngjs": "6.0.5",
    "@types/qrcode": "^1.5.5",
    "@types/ws": "^8.18.1",
    "esbuild": "0.28.2",
    "jsqr": "1.4.0",
    "pngjs": "7.0.0",
    "tsx": "4.23.15",
    "typescript": "7.0.2"
  }
}
